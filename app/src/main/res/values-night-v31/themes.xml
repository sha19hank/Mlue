<resources>
    <style name="Theme.DailyHabitTracker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Match DarkBackground editorial token — eliminates light-flash before first Compose frame in dark mode -->
        <item name="android:windowBackground">#0A0C10</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenAnimationDuration">250</item>
    </style>
</resources>
